---
const navLinks = [
  { href: "/theme", label: "The Kaupapa" },
  { href: "/journey", label: "Why New Zealand" },
  { href: "/travel", label: "Your Journey" },
  { href: "/journey#taonga", label: "Taonga & Koha" },
];
---

<header class="sticky top-0 z-40 w-full bg-primary-strong text-white">
  <!-- Desktop nav -->
  <div class="hidden lg:flex items-center justify-between px-16 py-6">
    <a href="/" class="flex items-center gap-5">
      <img
        src="/assets/ICN_logo_EN_baseline_W.png"
        alt="International Council of Nurses"
        class="h-10 w-auto"
      />
      <span class="h-7 w-px bg-white/20"></span>
      <img
        src="/assets/NZNO_white_PNG.png"
        alt="New Zealand Nurses Organisation"
        class="h-16 w-auto object-contain"
      />
    </a>
    <nav class="flex items-center gap-9">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="font-body text-sm font-medium text-white tracking-[0.04em] hover:text-accent transition-colors"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/register"
        class="inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-pill bg-accent px-5 py-2.5 text-sm font-semibold text-primary-strong tracking-[0.04em] hover:brightness-95 transition"
      >
        Register your interest
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
          ><path
            d="M3 7h8M8 4l3 3-3 3"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
    </nav>
  </div>

  <!-- Mobile nav bar -->
  <div class="flex items-center justify-between px-6 py-3 lg:hidden">
    <a href="/" class="flex items-center">
      <img
        src="/assets/ICN_logo_EN_baseline_W.png"
        alt="International Council of Nurses"
        class="h-7 w-auto"
      />
    </a>
    <button
      type="button"
      aria-label="Open navigation"
      data-nav-open
      class="flex h-11 w-11 flex-col items-center justify-center gap-1.5"
    >
      <span class="h-[1.6px] w-5 bg-white"></span>
      <span class="h-[1.6px] w-5 bg-white"></span>
      <span class="ml-1.5 h-[1.6px] w-3.5 bg-white"></span>
    </button>
  </div>
</header>
