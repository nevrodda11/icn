---
const links = [
  {
    href: "/theme",
    number: "01",
    label: "The Kaupapa",
    description: "Titiro Whakamuri. Arataki Whakamua.",
  },
  {
    href: "/journey",
    number: "02",
    label: "About Aotearoa",
    description: "The taonga, the koha, and the story.",
  },
  {
    href: "/travel",
    number: "03",
    label: "Your Journey",
    description: "Visas, Wellington, Tākina.",
  },
  {
    href: "/register",
    number: "04",
    label: "Register",
    description: "Join the voyage. Register your interest.",
    accent: true,
  },
];
---

<div
  data-nav-drawer
  class="hidden fixed inset-0 z-50 flex-col bg-primary-strong text-white"
>
  <div class="flex items-center justify-between px-6 pt-3 pb-8">
    <img
      src="/assets/ICN_logo_EN_baseline_W.png"
      alt="International Council of Nurses"
      class="h-7 w-auto"
    />
    <button
      type="button"
      aria-label="Close navigation"
      data-nav-close
      class="flex h-11 w-11 items-center justify-center"
    >
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none"
        ><path
          d="M5 5l12 12M17 5L5 17"
          stroke="#FFFFFF"
          stroke-width="1.8"
          stroke-linecap="round"></path></svg
      >
    </button>
  </div>

  <nav class="flex flex-1 flex-col gap-0 px-6 pb-8">
    <div class="flex items-center gap-2.5 pb-5">
      <span class="h-px w-6 bg-accent"></span>
      <span class="eyebrow text-[11px] text-accent">The Conference</span>
    </div>
    {
      links.map((link) => (
        <a
          href={link.href}
          class="flex items-center justify-between gap-4 border-b border-white/15 py-[18px]"
        >
          <div class="flex flex-col gap-0.5">
            <span
              class={`font-display text-[26px] font-semibold leading-tight tracking-[-0.02em] ${link.accent ? "text-accent" : "text-white"}`}
            >
              {link.number} · {link.label}
            </span>
            <span class="font-body text-xs text-white/55">
              {link.description}
            </span>
          </div>
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" class="shrink-0"
            ><path
              d="M6 11h11M12 6l5 5-5 5"
              stroke={link.accent ? "var(--color-accent)" : "#FFFFFF"}
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
        </a>
      ))
    }
  </nav>

  <div class="flex flex-col gap-5 border-t border-white/15 px-6 pt-6 pb-9">
    <div class="flex items-center gap-5">
      <img
        src="/assets/ICN_logo_EN_baseline_W.png"
        alt="ICN"
        class="h-7 w-auto"
      />
      <span class="h-5 w-px bg-white/20"></span>
      <img
        src="/assets/NZNO_white_PNG.png"
        alt="NZNO"
        class="h-9 w-auto object-contain"
      />
    </div>
    <div class="flex items-center justify-between gap-3">
      <span class="font-body text-xs text-white/65">conference@nzno.org.nz</span>
      <span class="font-body italic text-[11px] text-white/50"
        >Me mihi ki ngā mana whenua.</span
      >
    </div>
  </div>
</div>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>("[data-nav-open]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-nav-close]");
  const drawer = document.querySelector<HTMLDivElement>("[data-nav-drawer]");

  const open = () => {
    if (!drawer) return;
    drawer.classList.remove("hidden");
    drawer.classList.add("flex");
    document.body.style.overflow = "hidden";
  };
  const close = () => {
    if (!drawer) return;
    drawer.classList.add("hidden");
    drawer.classList.remove("flex");
    document.body.style.overflow = "";
  };

  openBtn?.addEventListener("click", open);
  closeBtn?.addEventListener("click", close);
</script>
