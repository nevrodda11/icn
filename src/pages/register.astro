---
import Layout from "../layouts/Layout.astro";

const promises = [
  "We'll email you a kōrero of welcome from NZNO within one week.",
  "You'll be the first to hear when the programme and abstract calls open.",
  "Early-bird ticket details arrive before public release in Q4 2027.",
];
---

<Layout title="Register your interest · ICN NP/APN Network Conference 2028">
  <!-- Page hero -->
  <section class="border-b border-border bg-background px-6 pt-12 pb-16 lg:px-24 lg:pt-24 lg:pb-28">
    <a href="/" class="inline-flex items-center gap-2 text-primary">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="font-body text-sm font-semibold tracking-[0.04em]">Back to Home</span>
    </a>
    <div class="mt-10 flex max-w-[1100px] flex-col gap-6 lg:mt-12">
      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-primary"></span>
        <span class="eyebrow text-xs text-primary">04 · Register your interest</span>
      </div>
      <h1 class="font-display text-[60px] font-semibold leading-[0.95] tracking-[-0.035em] text-ink lg:text-[128px]">
        Join the <em class="italic text-primary">voyage.</em>
      </h1>
      <p class="font-display text-[18px] font-normal leading-tight tracking-[-0.01em] text-ink-muted lg:text-[32px]">
        Te Whanganui-a-Tara, Aotearoa — 3 to 6 September 2028.
      </p>
    </div>
  </section>

  <!-- Form section -->
  <section class="bg-background px-6 py-20 lg:px-24 lg:py-32">
    <div class="mx-auto flex max-w-[1248px] flex-col gap-14 lg:flex-row lg:gap-24">
      <div class="flex max-w-[440px] shrink-0 flex-col gap-12">
        <div class="flex flex-col gap-6">
          <div class="flex items-center gap-3">
            <span class="h-px w-8 bg-secondary"></span>
            <span class="eyebrow text-xs text-secondary">Keep in touch</span>
          </div>
          <h2 class="font-display text-[28px] font-semibold leading-tight tracking-[-0.02em] text-ink lg:text-[40px]">
            Bring your paddle. We will bring ours.
          </h2>
          <p class="font-body text-base leading-relaxed text-ink-muted">
            Add your name below and we'll keep you up to date on the programme,
            keynotes, abstract calls, and ticket release.
          </p>
        </div>
        <div class="flex flex-col gap-5 border-t border-border pt-6">
          {
            promises.map((item, i) => (
              <div class="flex items-start gap-4">
                <span class="font-display text-xl font-semibold leading-none text-primary">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="font-body text-sm leading-relaxed text-ink-muted">
                  {item}
                </span>
              </div>
            ))
          }
        </div>
      </div>
      <form class="flex flex-1 flex-col gap-8 rounded-lg bg-surface-soft p-8 lg:p-14">
        <div class="flex flex-col gap-5 lg:flex-row lg:gap-5">
          <label class="flex flex-1 flex-col gap-2.5">
            <span class="eyebrow text-xs text-ink-muted">First name</span>
            <input
              type="text"
              name="firstName"
              placeholder="Your first name"
              class="w-full rounded-sm border border-border bg-background px-5 py-4 font-body text-base text-ink placeholder:text-ink-subtle focus:border-primary focus:outline-none"
            />
          </label>
          <label class="flex flex-1 flex-col gap-2.5">
            <span class="eyebrow text-xs text-ink-muted">Last name</span>
            <input
              type="text"
              name="lastName"
              placeholder="Your last name"
              class="w-full rounded-sm border border-border bg-background px-5 py-4 font-body text-base text-ink placeholder:text-ink-subtle focus:border-primary focus:outline-none"
            />
          </label>
        </div>
        <label class="flex flex-col gap-2.5">
          <span class="eyebrow text-xs text-ink-muted">Email address</span>
          <input
            type="email"
            name="email"
            placeholder="you@example.com"
            class="w-full rounded-sm border border-border bg-background px-5 py-4 font-body text-base text-ink placeholder:text-ink-subtle focus:border-primary focus:outline-none"
          />
        </label>
        <label class="flex flex-col gap-2.5">
          <span class="eyebrow text-xs text-ink-muted">Country or territory</span>
          <select
            name="country"
            class="w-full appearance-none rounded-sm border border-border bg-background px-5 py-4 font-body text-base text-ink-subtle focus:border-primary focus:outline-none"
          >
            <option value="">Select your country or territory</option>
            <option>Aotearoa New Zealand</option>
            <option>Australia</option>
            <option>Canada</option>
            <option>United Kingdom</option>
            <option>United States</option>
          </select>
        </label>
        <label class="flex items-start gap-3.5 pt-2">
          <input
            type="checkbox"
            class="mt-0.5 h-5 w-5 shrink-0 rounded-sm border-[1.5px] border-primary accent-primary"
          />
          <span class="font-body text-sm leading-relaxed text-ink-muted">
            I'd like NZNO to keep me updated about the ICN NP/APN Network
            Conference 2028. I understand my details will be held in line with
            NZNO's privacy policy.
          </span>
        </label>
        <div class="flex flex-col gap-5 pt-4 lg:flex-row lg:items-center lg:justify-between">
          <span class="font-body text-xs text-ink-subtle"
            >All fields required. Takes about 60 seconds.</span
          >
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-3.5 rounded-pill bg-primary px-9 py-5 font-body text-base font-semibold text-primary-contrast tracking-[0.04em] hover:bg-primary-strong transition"
          >
            Submit
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M3 9h11M10 4l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </form>
    </div>
  </section>
</Layout>
