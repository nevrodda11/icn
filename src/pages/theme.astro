---
import Layout from "../layouts/Layout.astro";

const pillars = [
  {
    title: "Clinical expertise",
    body: "Deep practice knowledge, shaped by lived experience of the whānau and communities we serve.",
  },
  {
    title: "Nursing values",
    body: "Grounded in whakawhanaungatanga, manaakitanga, and tiakitanga — the ethic of care that defines our mahi.",
  },
  {
    title: "Cultural understanding",
    body: "Mātauranga Māori woven alongside Pacific, Pākehā, and migrant perspectives in service of all our people.",
  },
  {
    title: "Systems leadership",
    body: "Redesigning services, mentoring the next generation of nurses, and influencing policy where it matters.",
  },
];
---

<Layout title="The 2028 Conference Theme · Titiro Whakamuri. Arataki Whakamua.">
  <!-- Page hero -->
  <section class="border-b border-border bg-background px-6 pt-12 pb-16 lg:px-24 lg:pt-24 lg:pb-28">
    <a href="/" class="inline-flex items-center gap-2 text-primary">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="font-body text-sm font-semibold tracking-[0.04em]">Back to Home</span>
    </a>
    <div class="mt-10 flex flex-col gap-8 lg:mt-12 lg:flex-row lg:items-end lg:justify-between lg:gap-24">
      <div class="flex max-w-[820px] flex-col gap-6">
        <div class="flex items-center gap-3">
          <span class="h-px w-8 bg-primary"></span>
          <span class="eyebrow text-xs text-primary">01 · The 2028 Conference Theme</span>
        </div>
        <h1 class="font-display text-[56px] font-semibold leading-[0.98] tracking-[-0.035em] text-ink lg:text-[120px]">
          Titiro Whakamuri.<br />
          <span class="text-primary">Arataki Whakamua.</span>
        </h1>
        <p class="font-display italic text-[22px] font-normal leading-tight tracking-[-0.01em] text-ink-muted lg:text-[36px]">
          Look Back. Lean Forward.
        </p>
      </div>
    </div>
  </section>

  <!-- Whakataukī image moment -->
  <section
    class="relative flex min-h-[460px] w-full flex-col justify-end lg:min-h-[760px]"
    style="background-image: url('/assets/clean-bid-72s.jpg'); background-size: cover; background-position: center;"
  >
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(90deg, rgba(34,30,82,0.9) 0%, rgba(34,30,82,0.45) 55%, rgba(34,30,82,0.15) 100%);"
    >
    </div>
    <div class="relative z-10 flex max-w-[820px] flex-col gap-6 px-6 pb-10 pt-14 lg:px-24 lg:py-24">
      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-accent"></span>
        <span class="eyebrow text-xs text-accent">Ka mua, ka muri</span>
      </div>
      <p class="font-display text-[26px] font-normal leading-tight tracking-[-0.015em] text-white lg:text-[64px] lg:leading-[1.08]">
        As we move forward, we are strengthened by those who have gone before
        us.
      </p>
      <span class="font-body text-[11px] text-white/55 lg:text-xs"
        >Film still · maunga wrapped in cloud, Aotearoa</span
      >
    </div>
  </section>

  <!-- Kaupapa explainer -->
  <section class="bg-background px-6 py-20 lg:px-24 lg:py-32">
    <div class="mx-auto flex max-w-[1248px] flex-col gap-10 lg:flex-row lg:gap-24">
      <div class="flex max-w-sm shrink-0 flex-col gap-5 lg:w-[280px]">
        <div class="flex items-center gap-3">
          <span class="h-px w-8 bg-secondary"></span>
          <span class="eyebrow text-xs text-secondary">The whakataukī</span>
        </div>
        <p class="font-body text-sm font-medium leading-relaxed text-ink-muted">
          A Māori proverb carried through generations of mātauranga.
        </p>
      </div>
      <div class="flex max-w-[820px] flex-col gap-8">
        <p class="font-display text-[26px] font-normal leading-tight tracking-[-0.02em] text-ink lg:text-[44px] lg:leading-[1.15]">
          Ka mua, <em class="italic">ka muri</em> — a Māori whakataukī, or
          proverb — reminds us that as we move forward, we are strengthened by
          the experiences, wisdom, and courage of those who have gone before us.
        </p>
        <p class="font-body text-base leading-relaxed text-ink-muted lg:text-lg">
          This is the kaupapa — the purpose and grounding — of our journey as
          Nurse Practitioners and Advanced Practice Nurses. Across Aotearoa New
          Zealand, we are leading change where it matters most — alongside
          whānau, communities, and services working for better, fairer health
          outcomes.
        </p>
      </div>
    </div>
  </section>

  <!-- Contribution hero -->
  <section class="bg-primary-strong px-6 py-20 text-white lg:px-24 lg:py-32">
    <div class="mx-auto flex max-w-[1248px] flex-col gap-14 lg:gap-20">
      <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:gap-24">
        <div class="flex max-w-sm shrink-0 flex-col gap-5 lg:w-[280px]">
          <div class="flex items-center gap-3">
            <span class="h-px w-8 bg-accent"></span>
            <span class="eyebrow text-xs text-accent">What we bring</span>
          </div>
          <p class="font-body text-sm font-medium leading-relaxed text-white/65">
            The contribution of Nurse Practitioners and Advanced Practice Nurses
            reaches far beyond the consultation room.
          </p>
        </div>
        <h2 class="max-w-[820px] font-display text-[32px] font-normal leading-tight tracking-[-0.025em] text-white lg:text-[56px] lg:leading-[1.1]">
          Our contribution reaches beyond diagnosis and treatment — we redesign
          services, strengthen communities, and influence policy for better,
          fairer health outcomes.
        </h2>
      </div>
      <div class="grid gap-4 lg:grid-cols-4 lg:gap-6">
        {
          pillars.map((p) => (
            <div class="flex flex-col gap-5 rounded-md border border-white/15 bg-white/5 p-6 lg:p-8">
              <span class="font-display text-[22px] font-semibold leading-tight tracking-[-0.015em] text-white lg:text-[26px]">
                {p.title}
              </span>
              <p class="font-body text-sm leading-relaxed text-white/75">
                {p.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Up next -->
  <section class="bg-background px-6 py-20 lg:px-24 lg:py-28">
    <div class="mx-auto flex max-w-[1248px] flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
      <div class="flex max-w-[720px] flex-col gap-4">
        <span class="eyebrow text-xs text-ink-subtle">Up next · 02</span>
        <h3 class="font-display text-[32px] font-semibold leading-tight tracking-[-0.025em] text-ink lg:text-[56px]">
          NZNO's Journey to 2028
        </h3>
        <p class="font-body text-base leading-relaxed text-ink-muted lg:text-lg">
          From the bid in Helsinki to the taonga presented in Nashville — the
          stories of how Aotearoa New Zealand came to host.
        </p>
      </div>
      <a
        href="/journey"
        class="inline-flex w-fit items-center gap-3 rounded-pill bg-ink px-7 py-4 text-base font-semibold text-primary-contrast tracking-[0.04em] hover:bg-primary transition lg:px-8 lg:py-5"
      >
        Read the journey
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M3 9h11M10 4l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>
</Layout>
