---
import Layout from "../layouts/Layout.astro";

const resources = [
  {
    number: "01",
    label: "Official",
    title: "Visa information",
    description: "Check requirements and apply through Immigration New Zealand.",
    url: "immigration.govt.nz",
    bg: "bg-ink",
    textPrimary: "text-white",
    textMuted: "text-white/72",
    accent: "text-accent",
    stroke: "var(--color-accent)",
    labelMuted: "text-white/50",
  },
  {
    number: "02",
    label: "Explore",
    title: "Tourism New Zealand",
    description:
      "Discover the whenua — landscapes, culture, and the stories of Aotearoa.",
    url: "newzealand.com",
    bg: "bg-primary",
    textPrimary: "text-white",
    textMuted: "text-white/78",
    accent: "text-white",
    stroke: "#FFFFFF",
    labelMuted: "text-white/60",
  },
  {
    number: "03",
    label: "Local",
    title: "WellingtonNZ",
    description:
      "The capital city guide — where to eat, drink, and spend time between sessions.",
    url: "wellingtonnz.com",
    bg: "bg-secondary",
    textPrimary: "text-primary-strong",
    textMuted: "text-primary-strong/78",
    accent: "text-primary-strong",
    stroke: "var(--color-primary-strong)",
    labelMuted: "text-primary-strong/65",
  },
  {
    number: "04",
    label: "Venue",
    title: "Tākina",
    description:
      "Convention & Exhibition Centre, our home for the four days of the conference.",
    url: "takina.co.nz",
    bg: "bg-accent",
    textPrimary: "text-primary-strong",
    textMuted: "text-primary-strong/78",
    accent: "text-primary-strong",
    stroke: "var(--color-primary-strong)",
    labelMuted: "text-primary-strong/65",
  },
];
---

<Layout title="Your Journey to Aotearoa New Zealand · Nau mai, haere mai">
  <!-- Page hero -->
  <section class="border-b border-border bg-background px-6 pt-12 pb-16 lg:px-24 lg:pt-24 lg:pb-28">
    <a href="/" class="inline-flex items-center gap-2 text-primary">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="font-body text-sm font-semibold tracking-[0.04em]">Back to Home</span>
    </a>
    <div class="mt-10 flex flex-col gap-8 lg:mt-12 lg:flex-row lg:items-end lg:justify-between lg:gap-24">
      <div class="flex max-w-[820px] flex-col gap-6">
        <div class="flex items-center gap-3">
          <span class="h-px w-8 bg-primary"></span>
          <span class="eyebrow text-xs text-primary">03 · Your journey to Aotearoa</span>
        </div>
        <h1 class="font-display text-[54px] font-semibold leading-[0.98] tracking-[-0.035em] text-ink lg:text-[120px]">
          Nau mai,<br /><em class="italic text-primary">haere mai</em>
        </h1>
        <p class="font-display text-[22px] font-normal leading-tight text-ink-muted lg:text-[32px]">
          Welcome to New Zealand
        </p>
      </div>
      <p class="max-w-sm font-body text-base leading-relaxed text-ink-muted lg:text-lg">
        Everything you need to know to plan your voyage to Te Whanganui-a-Tara
        for the conference, 3–6 September 2028.
      </p>
    </div>
  </section>

  <!-- Wellington image -->
  <section class="flex w-full flex-col bg-background">
    <div
      class="h-[240px] w-full bg-cover bg-center lg:h-[640px]"
      style="background-image: url('/assets/clean-bid-245s.jpg');"
    >
    </div>
    <div class="flex flex-col gap-3 px-6 pt-6 pb-10 lg:flex-row lg:items-end lg:justify-between lg:gap-12 lg:px-24 lg:pb-0 lg:pt-8">
      <div class="flex max-w-[820px] flex-col gap-3">
        <span class="eyebrow text-xs text-primary">Te Whanganui-a-Tara · Wellington</span>
        <p class="font-display italic text-[22px] font-normal leading-tight tracking-[-0.02em] text-ink lg:text-[32px]">
          A maritime capital city — nestled between hills and the moana.
        </p>
      </div>
      <span class="font-body text-xs text-ink-subtle lg:max-w-[220px] lg:text-right"
        >Wellington from across the harbour</span
      >
    </div>
  </section>

  <!-- Entry info -->
  <section class="bg-background px-6 py-20 lg:px-24 lg:py-32">
    <div class="mx-auto flex max-w-[1248px] flex-col gap-14 lg:gap-16">
      <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:gap-24">
        <div class="flex max-w-sm shrink-0 flex-col gap-5 lg:w-[320px]">
          <div class="flex items-center gap-3">
            <span class="h-px w-8 bg-secondary"></span>
            <span class="eyebrow text-xs text-secondary">Entry requirements</span>
          </div>
          <h2 class="font-display text-[32px] font-semibold leading-tight tracking-[-0.025em] text-ink lg:text-[56px]">
            Before you arrive.
          </h2>
        </div>
        <p class="max-w-[540px] font-body text-base leading-relaxed text-ink-muted lg:text-lg">
          New Zealand welcomes visitors from 60+ countries and territories
          visa-free. The notes below are a quick orientation — always check the
          official sources for current requirements before you travel.
        </p>
      </div>
      <div class="grid gap-4 lg:grid-cols-2 lg:gap-6">
        <div class="flex flex-col gap-6 rounded-md bg-surface-soft p-8 lg:p-10">
          <div class="flex items-center gap-3">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <rect x="4" y="4" width="20" height="20" rx="2" stroke="var(--color-primary)" stroke-width="1.6" />
              <path d="M8 10h12M8 14h8M8 18h10" stroke="var(--color-primary)" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <span class="eyebrow text-xs text-primary">Visa</span>
          </div>
          <div class="flex flex-col gap-3">
            <h3 class="font-display text-[22px] font-semibold leading-tight tracking-[-0.02em] text-ink lg:text-[32px]">
              Visa-free from 60+ countries
            </h3>
            <p class="font-body text-base leading-relaxed text-ink-muted">
              Delegates from non–visa-waiver countries will need to apply for a
              visa through Immigration New Zealand. Allow at least 8 weeks
              before travel for processing.
            </p>
          </div>
        </div>
        <div class="flex flex-col gap-6 rounded-md bg-surface-soft p-8 lg:p-10">
          <div class="flex items-center gap-3">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <path d="M14 25s-9-5.5-9-13A6 6 0 0114 7.5 6 6 0 0123 12c0 7.5-9 13-9 13z" stroke="var(--color-secondary)" stroke-width="1.6" stroke-linejoin="round" />
            </svg>
            <span class="eyebrow text-xs text-secondary">Health</span>
          </div>
          <div class="flex flex-col gap-3">
            <h3 class="font-display text-[22px] font-semibold leading-tight tracking-[-0.02em] text-ink lg:text-[32px]">
              No vaccination requirements
            </h3>
            <p class="font-body text-base leading-relaxed text-ink-muted">
              New Zealand does not impose any vaccination requirements for
              entry. We recommend speaking with your home-country travel health
              provider ahead of travel.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Resource tiles -->
  <section class="bg-background px-6 pb-20 pt-0 lg:px-24 lg:pb-32">
    <div class="mx-auto flex max-w-[1248px] flex-col gap-14 lg:gap-16">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:gap-24">
        <div class="flex max-w-sm shrink-0 flex-col gap-5 lg:w-[320px]">
          <div class="flex items-center gap-3">
            <span class="h-px w-8 bg-primary"></span>
            <span class="eyebrow text-xs text-primary">Useful links</span>
          </div>
          <h2 class="font-display text-[32px] font-semibold leading-tight tracking-[-0.025em] text-ink lg:text-[56px]">
            Plan your trip.
          </h2>
        </div>
        <p class="max-w-[540px] font-body text-base leading-relaxed text-ink-muted lg:text-lg">
          Four official sources will carry you from your home airport to the
          doors of Tākina. We will keep adding travel partners as planning
          progresses.
        </p>
      </div>
      <div class="grid gap-4 lg:grid-cols-4 lg:gap-6">
        {
          resources.map((r) => (
            <a
              href="#"
              class={`flex min-h-[220px] flex-col justify-between gap-8 rounded-md p-6 lg:p-8 lg:min-h-[360px] ${r.bg} transition hover:-translate-y-1`}
            >
              <div class="flex items-baseline justify-between">
                <span class={`font-display text-[32px] font-semibold leading-none tracking-[-0.03em] lg:text-[56px] ${r.accent}`}>
                  {r.number}
                </span>
                <span class={`eyebrow text-[11px] lg:text-xs ${r.labelMuted}`}>{r.label}</span>
              </div>
              <div class="flex flex-col gap-3">
                <h3 class={`font-display text-[22px] font-semibold leading-tight tracking-[-0.02em] lg:text-[32px] ${r.textPrimary}`}>
                  {r.title}
                </h3>
                <p class={`font-body text-sm leading-relaxed ${r.textMuted}`}>
                  {r.description}
                </p>
              </div>
              <div class="flex items-center justify-between">
                <span class={`font-body text-sm font-semibold tracking-[0.04em] ${r.accent}`}>
                  {r.url}
                </span>
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                  <path d="M8 14l6-6M9 8h5v5" stroke={r.stroke} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Up next -->
  <section class="border-t border-border bg-background px-6 py-20 lg:px-24 lg:py-28">
    <div class="mx-auto flex max-w-[1248px] flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-16">
      <div class="flex max-w-[720px] flex-col gap-4">
        <span class="eyebrow text-xs text-ink-subtle">Up next · 04</span>
        <h3 class="font-display text-[32px] font-semibold leading-tight tracking-[-0.025em] text-ink lg:text-[56px]">
          Register your interest for 2028
        </h3>
        <p class="font-body text-base leading-relaxed text-ink-muted lg:text-lg">
          Add your name to the list and we'll keep you up to date as the
          programme, keynotes, and tickets open.
        </p>
      </div>
      <a
        href="/register"
        class="inline-flex w-fit items-center gap-3 rounded-pill bg-ink px-7 py-4 text-base font-semibold text-primary-contrast tracking-[0.04em] hover:bg-primary transition lg:px-8 lg:py-5"
      >
        Register your interest
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M3 9h11M10 4l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>
</Layout>
